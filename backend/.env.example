# Copy to backend/.env and fill in. Never commit .env.
# AI provider: "gemini" (Gemma via Google AI Studio) or "groq". Leave AI_PROVIDER empty to auto-detect from the keys below.
AI_PROVIDER=
GEMINI_API_KEY=your-google-ai-studio-key
GEMMA_MODEL=gemma-4-26b-a4b-it
# Fallback if you cannot get Gemma access: set AI_PROVIDER=groq and fill these in (key from console.groq.com).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=60
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
API_THROTTLE_RATE=200/hour
